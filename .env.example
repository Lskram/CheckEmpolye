# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Store Default Geofence & Shift Rules (Can be updated via Admin Panel)
NEXT_PUBLIC_DEFAULT_STORE_LAT=13.7563
NEXT_PUBLIC_DEFAULT_STORE_LNG=100.5018
NEXT_PUBLIC_DEFAULT_STORE_RADIUS_METERS=50
NEXT_PUBLIC_STANDARD_SHIFT_TIME=07:40
NEXT_PUBLIC_ALLOWANCE_DEADLINE_TIME=08:00
NEXT_PUBLIC_ALLOWANCE_AMOUNT=50

# LINE Notification Integration (Optional: for auto alerts on late check-in)
LINE_NOTIFY_TOKEN=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_GROUP_ID=
